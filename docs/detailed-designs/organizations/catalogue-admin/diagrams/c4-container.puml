@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Catalogue and organization admin
Person(caller, "Portfolio Lead or System Admin", "")
System_Boundary(ftc, "QuinntyneBrown.Community") {
  Container(web, "Web app", "Angular", "Shell, organizations and feature libraries, api and components libraries")
  Container(api, "Community API", "ASP.NET Core", "QuinntyneBrown.Community.Api with Application, Domain and Infrastructure")
  ContainerDb(db, "Community database", "PostgreSQL", "Hierarchy, memberships, catalogues and org-owned records")
}
Rel(caller, web, "Uses /o/{slug}/admin/... portfolio screens", "HTTPS")
Rel(web, api, "Org Type, role catalogue and organization endpoints", "JSON/HTTPS")
Rel(api, db, "OrgTypes, RoleDefinitions, Organizations, OrgSlugAliases, AuditEntries", "EF Core")
@enduml
