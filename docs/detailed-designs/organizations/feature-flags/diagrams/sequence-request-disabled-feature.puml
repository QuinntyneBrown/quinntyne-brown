@startuml
title UML sequence behaviour — Call a disabled feature
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Shelfie Org Lead" as actor
box "Frontend — QuinntyneBrown.Community web app" #E0F2FE
  participant "Shell navigation" as nav
end box
box "Backend — QuinntyneBrown.Community.Api" #D1FADF
  participant "EventsEndpoints" as ep
end box
box "Backend — QuinntyneBrown.Community.Application and Domain" #ECFDF3
  participant "AccessResolver" as res
  participant "OrgScope" as scope
end box
box "Backend — QuinntyneBrown.Community.Infrastructure" #FFF4E5
  database "Community database" as db
end box
actor -> nav : Open /o/shelfie
nav --> actor : No Events section (feature("events") false) (L2-147 #1)
actor -> ep : GET /api/events (X-Org: shelfie)
ep -> res : CallerAccess
res -> db : OrgType "Startup".EnabledFeatures
res --> ep : Shelfie covered; events off; Org Lead codes for events dropped
ep -> scope : Read(access, shelfie, "events")
scope --> ep : NotFound
ep --> actor : 404 (L2-147 #2)
actor -> ep : GET /api/events/{id of a Shelfie event}
ep --> actor : 404 (L2-147 #2)
actor -> ep : GET /api/events (X-Org: all)
ep -> db : WHERE OrganizationId IN (covered orgs with events on)
ep --> actor : 200 without Shelfie rows (L2-147 #3)
@enduml
