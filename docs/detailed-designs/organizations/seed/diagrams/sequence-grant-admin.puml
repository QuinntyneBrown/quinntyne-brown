@startuml
title UML sequence behaviour — Grant the first administrator
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as op
box "Backend — QuinntyneBrown.Community.Cli" #D1FADF
  participant "GrantAdminCommand" as cli
end box
box "Backend — QuinntyneBrown.Community.Infrastructure" #FFF4E5
  participant "CommunitySeeder" as seeder
  database "Community database" as db
end box
op -> cli : grant-admin quinntyne@...
cli -> seeder : GrantSystemAdminAsync(email)
seeder -> db : Profile by verified email
alt no account
  seeder --> cli : Error, exit 1
else
  seeder -> db : Profile.IsSystemAdmin = true
  seeder -> db : PortfolioLead(Quinntyne Brown) if missing
  seeder -> db : OrgMembership(FaithTech Toronto, IsOrgLead = true) if missing
  seeder -> db : Audit entries (actor empty, IP "cli")
  seeder --> cli : Done (L2-157 #3)
end
@enduml
