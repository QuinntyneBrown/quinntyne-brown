@startuml
title UML sequence behaviour — Rotate a secret without dropping events
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Org Lead" as lead
participant "Publisher (Goodwork)" as pub
box "Backend — QuinntyneBrown.Community" #D1FADF
  participant "Community API" as api
end box
lead -> api : Rotate secret (T)
api --> lead : new secret, shown once; old secret valid until T + 24 h
pub -> api : events signed with the old secret
api --> pub : 202
lead -> pub : deploy the new secret
pub -> api : events signed with the new secret
api --> pub : 202
pub -> api : event signed with the old secret after T + 24 h
api --> pub : 401
@enduml
